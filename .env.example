# Discord bot token (Bot -> Token)                     [必填]
DISCORD_TOKEN=

# Application id (General Information -> Application ID) [部署命令必填；代码也接受 CLIENT_ID]
DISCORD_APPLICATION_ID=

# 可选：把命令注册到该服务器（即时生效）；留空则只注册全局命令（最长约 1 小时生效）。
# 只注册一处作用域，另一处会被清空，避免客户端把同名命令显示两遍。<别名 GUILD_ID>
DISCORD_GUILD_ID=

# 可选：多个服务器 id（逗号/空格分隔），与 DISCORD_GUILD_ID 合并去重。
# 一般不填：bot 启动时会对**当前所在的所有服务器**自动同步，被邀请进新服务器也会自动补注册。
# 这个变量主要用于「bot 尚未加入、但想预先登记」之外的手工场景：node src/bot/deploy.ts
DISCORD_GUILD_IDS=

# 可选：设为 0 关闭启动/入群时的自动同步（命令由 CI 统一管理时用）
DCDICE_AUTO_SYNC_COMMANDS=1

# 可选：角色卡 / 局 / 日志 的 JSON 数据目录，默认 ./data
DCDICE_DATA_DIR=./data

# 可选：出站 HTTP 代理。直连被墙时必填；会同时接管 REST 与网关 WebSocket。
HTTPS_PROXY=http://127.0.0.1:7901
HTTP_PROXY=http://127.0.0.1:7901
